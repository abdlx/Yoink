# Required. Use a unique password of at least 12 characters.
# Single quotes preserve special characters such as $ and # in Docker Compose.
APP_PASSWORD='change-this-password'

# Open http://YOUR_SERVER_IP:8080 after starting the app.
PORT=8080
BIND_ADDRESS=0.0.0.0

# Host folder for downloaded files. Absolute paths are supported.
DOWNLOAD_PATH=./downloads

# Fetch the latest stable release directly from official yt-dlp GitHub on each start.
# With false, use the version already included in the built image.
UPDATE_YTDLP=true
MAX_CONCURRENT_DOWNLOADS=2
SESSION_HOURS=24

# Set true when serving over HTTPS through your reverse proxy.
COOKIE_SECURE=false
# Set to the exact browser-facing URL when using an HTTPS reverse proxy or Coolify.
# Do not include the internal container port (8080) or a URL path.
# APP_ORIGIN=https://downloads.example.com

# Linux owner for new files and the mounted download/data directories.
PUID=1000
PGID=1000
