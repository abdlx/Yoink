{
  "name": "yoink-webui",
  "version": "0.1.0",
  "private": true,
  "description": "A private React dashboard for yt-dlp",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src vite.config.ts playwright.config.ts e2e",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts e2e",
    "brand:assets": "node scripts/brand-assets.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
